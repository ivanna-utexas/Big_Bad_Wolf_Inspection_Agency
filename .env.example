# Required: SerpApi key (backend only, never sent to the browser)
SERPAPI_API_KEY=
# Optional: Gemini key for the wolf's narration. Without it, canned lines are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview,gemini-3.8-flash
# Optional knobs
# BBW_CACHE_PATH=cache.sqlite3
# BBW_AUTOCOMPLETE=1      # set 0 to turn off search-box suggestions (saves credits)
# BBW_JSON_RESTRICTOR=1   # set 0 to request full SerpApi payloads
