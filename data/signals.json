{
  "_comment": "Edit freely. terms are case-insensitive regexes. weight > 0 means risk, < 0 means reassuring. negatable: skip a match right after 'no', 'never had', 'without', etc. probes are the keywords sent to google_maps_reviews as query=<keyword>.",
  "probes": ["mold", "leak", "roach", "maintenance", "deposit"],
  "signals": [
    {"id": "mold", "label": "mold / mildew", "theme": "Water & Mold", "weight": 10, "negatable": true,
     "terms": ["\\bmold(?:y|ing)?\\b", "\\bmould\\b", "\\bmildew"]},
    {"id": "flood", "label": "flooding", "theme": "Water & Mold", "weight": 9, "negatable": true,
     "terms": ["\\bflood(?:ed|ing|s)?\\b"]},
    {"id": "leak", "label": "leaks", "theme": "Water & Mold", "weight": 8, "negatable": true,
     "terms": ["\\bleak(?:s|ed|ing|y)?\\b", "water damage"]},
    {"id": "roach", "label": "roaches", "theme": "Pests", "weight": 10, "negatable": true,
     "terms": ["\\b(?:cock)?roach(?:es)?\\b"]},
    {"id": "bedbugs", "label": "bed bugs", "theme": "Pests", "weight": 10, "negatable": true,
     "terms": ["\\bbed ?bugs?\\b"]},
    {"id": "rodents", "label": "rats / mice", "theme": "Pests", "weight": 9, "negatable": true,
     "terms": ["\\brats?\\b", "\\bmice\\b", "\\brodents?\\b"]},
    {"id": "pests", "label": "bugs / pests", "theme": "Pests", "weight": 6, "negatable": true,
     "terms": ["\\bpests?\\b", "\\binfest(?:ed|ation)\\b", "\\bants\\b"]},
    {"id": "no_hot_water", "label": "no hot water", "theme": "Broken Basics", "weight": 8, "negatable": false,
     "terms": ["no hot water", "without hot water", "hot water (?:went|was|is) out", "cold showers?"]},
    {"id": "no_ac", "label": "AC broken", "theme": "Broken Basics", "weight": 8, "negatable": false,
     "terms": ["\\bno (?:ac|a/c|air conditioning)\\b", "\\b(?:ac|a/c|air conditioning|hvac)\\b[^.!?]{0,30}\\b(?:broke|broken|out|not working|stopped working|went out|died)\\b"]},
    {"id": "break_in", "label": "break-ins", "theme": "Safety", "weight": 9, "negatable": true,
     "terms": ["break[- ]?ins?\\b", "broke into", "\\bburglar", "\\bstolen car\\b", "car (?:was )?broken into"]},
    {"id": "unsafe", "label": "feels unsafe", "theme": "Safety", "weight": 8, "negatable": true,
     "terms": ["\\bunsafe\\b", "not safe", "don'?t feel safe", "didn'?t feel safe", "\\bsketchy\\b"]},
    {"id": "maint_slow", "label": "maintenance ignored / slow", "theme": "Maintenance", "weight": 7, "negatable": false,
     "terms": ["maintenance (?:never|ignored|ignores|takes forever|took forever|is slow|was slow|is a joke)", "took (?:weeks|months|over a week)", "(?:weeks|months) to (?:fix|repair|come)", "work orders? (?:ignored|never|went unanswered|sat)", "never (?:fixed|came|showed up|responded)"]},
    {"id": "hidden_fees", "label": "hidden fees", "theme": "Money & Deposits", "weight": 6, "negatable": true,
     "terms": ["hidden fees?", "(?:random|surprise|ridiculous|bogus) (?:fees?|charges?)", "nickel and dime", "overcharg"]},
    {"id": "deposit", "label": "deposit not returned / disputed", "theme": "Money & Deposits", "weight": 7, "negatable": false,
     "terms": ["deposit (?:back|was never|never|not returned|withheld|kept)", "(?:kept|keep|keeping|stole|withheld) (?:my|our|the) (?:security )?deposit", "charged (?:me|us) for (?:damage|cleaning|carpet|paint)"]},
    {"id": "rude_office", "label": "rude office", "theme": "Office Attitude", "weight": 5, "negatable": true,
     "terms": ["\\brude\\b", "unprofessional", "disrespectful", "condescending", "never answer(?:s|ed)? (?:the )?(?:phone|emails?)"]},
    {"id": "thin_walls", "label": "thin walls", "theme": "Noise", "weight": 3, "negatable": true,
     "terms": ["thin walls", "walls are (?:paper )?thin", "paper[- ]thin"]},
    {"id": "noise", "label": "noise", "theme": "Noise", "weight": 2, "negatable": true,
     "terms": ["\\bnois(?:e|y)\\b", "\\bloud\\b", "\\bparties\\b"]},
    {"id": "elevator", "label": "elevator broken", "theme": "Broken Basics", "weight": 3, "negatable": false,
     "terms": ["elevators? (?:is |are |was |were )?(?:always |constantly )?(?:broken|broke|out|down|not working)"]},
    {"id": "towed", "label": "parking / towing", "theme": "Parking & Packages", "weight": 3, "negatable": true,
     "terms": ["\\btow(?:ed|ing)\\b", "parking (?:is )?(?:a nightmare|terrible|horrible)"]},
    {"id": "packages", "label": "packages stolen", "theme": "Parking & Packages", "weight": 3, "negatable": true,
     "terms": ["packages? (?:were |was |got |get |keep getting )?(?:stolen|missing|lost)", "package theft"]},
    {"id": "maint_good", "label": "responsive maintenance", "theme": "Solid Upkeep", "weight": -6, "negatable": false,
     "terms": ["maintenance (?:is|was|team is|team was|staff is|staff was)? ?(?:super |very |really |always )?(?:quick|fast|responsive|prompt|great|amazing|on it)", "(?:fixed|repaired|came) (?:the )?same day", "fixed (?:it )?(?:within|in) (?:a day|an hour|hours|24 hours)"]},
    {"id": "well_maintained", "label": "well maintained", "theme": "Solid Upkeep", "weight": -5, "negatable": false,
     "terms": ["well[- ]maintained", "well[- ]kept", "\\bspotless\\b", "very clean", "always clean"]},
    {"id": "quiet", "label": "quiet", "theme": "Peace & Quiet", "weight": -3, "negatable": true,
     "terms": ["\\bquiet\\b", "peaceful"]},
    {"id": "secure", "label": "secure", "theme": "Feels Safe", "weight": -4, "negatable": true,
     "terms": ["\\bsecure\\b", "feel(?:s)? (?:very |really )?safe", "felt (?:very |really )?safe"]},
    {"id": "renovated", "label": "renovated / new appliances", "theme": "Solid Upkeep", "weight": -1, "negatable": false,
     "terms": ["\\brenovated\\b", "new appliances", "newly (?:updated|remodeled)"]}
  ]
}
